```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
.env
.env.local
*.env.*
pip-log.txt
pip-selfcheck.json

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Build artifacts
build/
dist/
target/
*.egg-info/

# Testing and coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
```