# ============================================================
# SubGenerator — репозиторий ПК-версии (Windows)
# В корне только соурс (generate.py) и батники на сборку.
# ============================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Dependencies
.venv/
venv/
.env
.env.local
*.env.*
pip-log.txt
pip-selfcheck.json

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Runtime data (создаётся при запуске; sources.txt — исключение, хранится)
data/report.json
data/run.log
data/settings.json
data/geo_cache.json
data/working*.txt
data/subs*.txt
data/.runtime_cache/
subs.txt
working*.txt
subs_*.txt

# Build artifacts (ПК)
build/
dist/
target/
*.egg-info/

# Binaries: ядра ПК скачиваются/обновляются отдельно (см. bin/CORE_VERSIONS.txt)
# bin/ в репозитории хранится (готовые ядра), раскомментируйте чтобы исключить:
# bin/*.exe
