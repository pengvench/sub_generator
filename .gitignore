# ============================================================
# SubGenerator — репозиторий ПК-версии (Windows)
# В корне только соурс (generate.py) и батники на сборку.
# ============================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Dependencies
.venv/
venv/
.env
.env.local
*.env.*
pip-log.txt
pip-selfcheck.json

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/


!data/happ_keys/
data/happ_keys/*
!data/happ_keys/README.md

!data/tg_subs.txt
!data/preload.txt
!data/preload_bs.txt
!data/preload_chs.txt
!data/pool_bs.txt
!data/pool_chs.txt
